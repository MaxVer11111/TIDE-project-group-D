@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tide: <https://example.invalid/tide/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <urn:tide:resource:p1:v1> ;
            sh:resultMessage "rights_holder: required or invalid value" ;
            sh:resultPath tide:rights_holder ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "rights_holder: required or invalid value" ;
                    sh:minCount 1 ;
                    sh:minLength 1 ;
                    sh:path tide:rights_holder ] ] .

